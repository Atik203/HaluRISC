# Python
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so

# Data (large files)
data/raw/
data/processed/*.parquet
!data/processed/.gitkeep

# Runtime retrieval index built from uploaded documents (Chat mode)
data/processed/retrieval_index/

# Models & Artifacts
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/figures/*
!artifacts/figures/.gitkeep
artifacts/results/*
!artifacts/results/.gitkeep
# B5.5 audit sheet + length-binned error analysis ship with the release (paper artifacts)
!artifacts/results/b5/
artifacts/results/b5/*
!artifacts/results/b5/b5_review_cases_reviewed.csv
!artifacts/results/b5/b5_length_error_analysis.csv
!artifacts/results/b5/b5_length_error_analysis.json

# Environment & Keys
.env
.env.local
.env.*.local

# Node / Next.js
web/node_modules/
web/.next/
web/out/
web/build/
web/.vercel/
web/*.log

# Local chat history database (created at runtime)
web/data/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp


