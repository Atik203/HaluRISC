# Python
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so

# Data (large files)
data/raw/
data/processed/*.parquet
!data/processed/.gitkeep

# Runtime retrieval index built from uploaded documents (Chat mode)
data/processed/retrieval_index/

# Models & Artifacts
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/figures/*
!artifacts/figures/.gitkeep
artifacts/results/*
!artifacts/results/.gitkeep
# B5.5 audit sheet + length-binned error analysis ship with the release (paper artifacts)
!artifacts/results/b5/
artifacts/results/b5/*
!artifacts/results/b5/b5_review_cases_reviewed.csv
!artifacts/results/b5/b5_length_error_analysis.csv
!artifacts/results/b5/b5_length_error_analysis.json

# Review-response analyses ship with the release (shortcut controls, threshold sweeps, ablation)
!artifacts/results/extras/
artifacts/results/extras/*
!artifacts/results/extras/*.json

# Review-response analyses land in their own namespace (calibration protocol, length control)
!artifacts/results/review/
artifacts/results/review/*
!artifacts/results/review/*.json
!artifacts/results/review/*.csv
!artifacts/results/review/*.log
!artifacts/results/review/neural_baseline/
artifacts/results/review/neural_baseline/*
!artifacts/results/review/neural_baseline/*.json
!artifacts/results/review/neural_baseline/*.csv

# Web-local artifact mirror ships with the frontend so the Vercel build is self-contained
!web/artifacts/
!web/artifacts/**

# Environment & Keys
.env
.env.local
.env.*.local

# Node / Next.js
web/node_modules/
web/.next/
web/out/
web/build/
web/.vercel/
web/*.log

# Local chat history database (created at runtime)
web/data/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp


artifacts/results/review/api_server.log
