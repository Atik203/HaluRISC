# Python
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
# H200 server-local runtime (never committed): venv, uv tools, HF cache, logs
.venv-h200/
.tools/
.hf-cache/
.setup.log
.env.h200
# Data (large files)
data/raw/
data/processed/*.parquet
!data/processed/.gitkeep
.env
# Runtime retrieval index built from uploaded documents (Chat mode)
data/processed/retrieval_index/

# Models & Artifacts
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/figures/*
!artifacts/figures/.gitkeep
artifacts/results/*
!artifacts/results/.gitkeep
# B5.5 audit sheet + length-binned error analysis ship with the release (paper artifacts)
!artifacts/results/b5/
artifacts/results/b5/*
!artifacts/results/b5/b5_review_cases_reviewed.csv
!artifacts/results/b5/b5_length_error_analysis.csv
!artifacts/results/b5/b5_length_error_analysis.json

# Review-response analyses ship with the release (shortcut controls, threshold sweeps, ablation)
!artifacts/results/extras/
artifacts/results/extras/*
!artifacts/results/extras/*.json

# Review-response analyses land in their own namespace (calibration protocol, length control)
!artifacts/results/review/
artifacts/results/review/*
!artifacts/results/review/*.json
!artifacts/results/review/*.csv
!artifacts/results/review/*.log
!artifacts/results/review/neural_baseline/
artifacts/results/review/neural_baseline/*
!artifacts/results/review/neural_baseline/*.json
!artifacts/results/review/neural_baseline/*.csv
!artifacts/results/review/neural_adapted/
artifacts/results/review/neural_adapted/*
!artifacts/results/review/neural_adapted/*.json
!artifacts/results/review/neural_adapted/*.csv

# H200 appendix runs (encoder ablation, length-matched control, local judge, efficiency)
!artifacts/results/h200/
artifacts/results/h200/*
!artifacts/results/h200/*.json
!artifacts/results/h200/*.csv
!artifacts/results/h200/*.md
!artifacts/results/h200/*.log
!artifacts/results/h200/*.tex
# Per-run encoder outputs (needed to reproduce the McNemar tests and per-seed means)
!artifacts/results/h200/b6_base/
artifacts/results/h200/b6_base/*
!artifacts/results/h200/b6_base/*.csv
!artifacts/results/h200/b6_base/*.json
!artifacts/results/h200/b6_base/*.parquet
!artifacts/results/h200/b6_nli-large/
artifacts/results/h200/b6_nli-large/*
!artifacts/results/h200/b6_nli-large/*.csv
!artifacts/results/h200/b6_nli-large/*.json
!artifacts/results/h200/b6_nli-large/*.parquet
!artifacts/results/h200/b6_bge-base/
artifacts/results/h200/b6_bge-base/*
!artifacts/results/h200/b6_bge-base/*.csv
!artifacts/results/h200/b6_bge-base/*.json
!artifacts/results/h200/b6_bge-base/*.parquet

# Web-local artifact mirror ships with the frontend so the Vercel build is self-contained
!web/artifacts/
!web/artifacts/**

