# ==============================================================================
# HaluRISC Environment Variables Template (.env.example)
# Copy the backend keys to .env (repo root); copy the NEXT_PUBLIC_* keys to
# web/.env.local (Next.js). NEVER commit actual API keys or secrets to git
# (.env and .env.local are gitignored).
# ==============================================================================

# --- LLM APIs (used by Next.js /api/chat and FastAPI /judge) ---
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-5.6-luna
# Web search for Tier 3 evidence (server-side only). Brave is preferred:
# set BRAVE_SEARCH_API_KEY (https://brave.com/search/api/), or keep Tavily
# (https://tavily.com) as the legacy fallback.
BRAVE_SEARCH_API_KEY=
# Optional: Brave Answers plan key (grounded, cited replies for POST /answer).
# Falls back to BRAVE_SEARCH_API_KEY when that key is entitled to Answers.
BRAVE_ANSWERS_API_KEY=
TAVILY_API_KEY=
# auto = Brave when its key is set, else Tavily | brave | tavily
HALU_WEB_SEARCH_PROVIDER=auto
# Brave free tier allows 2 requests/second; calls are spaced by this gap (s).
HALU_BRAVE_MIN_INTERVAL=0.55
# LLM Context token budget per query (1024-32768).
HALU_BRAVE_CONTEXT_TOKENS=4096

# --- FastAPI Python Backend Configuration (src/api/, root .env) ---
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
# Device for API inference models (spaCy/NLI/SBERT). Default cpu = stable
# (avoids VRAM OOM / silent process exits on small GPUs). cuda = GPU inference.
HALU_API_DEVICE=cpu
# 1 = preload heavy models at startup; 0 = load lazily on first request.
HALU_API_PRELOAD=1
# Device for XGBoost training. Keep cpu for artifacts that load on any platform
# (CUDA-trained boosters do not unserialize cross-platform).
HALU_XGB_DEVICE=cpu

# --- Next.js Frontend Configuration (web/.env.local) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ML_API_URL=http://127.0.0.1:8000

# --- Tier 4: LLM-judge routing (borderline claims only) + rate limits ---
HALU_JUDGE_CONF_LOW=0.50
HALU_JUDGE_CONF_HIGH=0.75
HALU_JUDGE_MAX_CLAIMS=3
HALU_RATE_VERIFY=30/minute
HALU_RATE_INDEX=10/minute
HALU_RATE_JUDGE=10/minute
HALU_RATE_FEEDBACK=30/minute
HALU_RATE_ANSWER=5/minute
