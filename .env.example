# ==============================================================================
# HaluRISC Environment Variables Template (.env.example)
# Copy this file to .env (for Python backend) or web/.env.local (for Next.js)
# NEVER commit actual API keys or secrets to git (.env and .env.local are gitignored)
# ==============================================================================

# --- OpenAI API Configuration (Used by Next.js /api/chat route & FastAPI /judge endpoint) ---
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-5.6-luna

# --- DeepSeek API Configuration (Optional fallback for LLM-as-judge baseline) ---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-v4-flash-0731

# --- FastAPI Python Backend Configuration (src/api/) ---
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_DEBUG=true
# Device for API inference models (spaCy/NLI/SBERT). Default cpu = stable
# (avoids VRAM OOM / silent process exits on small GPUs). cuda = GPU inference.
HALU_API_DEVICE=cpu

# --- Next.js Frontend Configuration (web/) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ML_API_URL=http://127.0.0.1:8000
